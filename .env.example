# Local dev only — use Render / dashboard for production secrets.

NODE_ENV=development

# Required in production: long random string (never commit the real value).
JWT_SECRET=replace-with-a-long-random-string

# Optional: comma-separated HTTPS origins allowed to use the API + Socket.IO.
# Example: https://your-app.onrender.com
# If unset in production, only same-origin browser access is allowed.
# CORS_ORIGIN=

# Optional limits (defaults are safe for a public demo)
# JSON_BODY_LIMIT=256kb
# API_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=25
# MAX_SOURCE_BYTES=409600
# COMPILE_TIMEOUT_MS=60000
# EXEC_TIMEOUT_MS=300000
